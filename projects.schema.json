{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[^<>{}]+$"
      },
      "repo": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
      },
      "category": {
        "type": "string",
        "maxLength": 30,
        "pattern": "^[^<>{}]*$"
      },
      "description": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[^<>{}]*$"
      }
    },
    "required": ["name", "repo"],
    "additionalProperties": false
  }
}