{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "repo": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
      },
      "category": {
        "type": "string",
        "maxLength": 30
      },
      "description": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": ["name", "repo"],
    "additionalProperties": false
  }
}